# Copy to .env (or run scripts/dev-env.sh to generate random values).
VULNX_ADMIN_PASSWORD=change-me
# Optional bootstrap ingest token (>= 16 chars), also used by the testbed.
VULNX_INGEST_TOKEN=
VULNX_PORT=8080
# VULNX_COOKIE_SECURE=true   # behind HTTPS
# VULNX_EVENT_RETENTION=50000
# VULNX_MAX_REPORT_MB=256
# Alerts about new findings (webhook URLs often embed a secret: keep them here only).
# VULNX_NOTIFY_URL=https://ntfy.sh/your-topic
# VULNX_NOTIFY_FORMAT=json          # json (Slack, Discord, Mattermost, Gotify, generic) | ntfy
# VULNX_NOTIFY_MIN_SEVERITY=Critical
# VULNX_NOTIFY_KEV=true             # also alert on known-exploited findings below that severity
# VULNX_PUBLIC_URL=http://vulnx.lan:8080   # for links in alerts
