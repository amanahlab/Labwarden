# Copy to .env (or run scripts/dev-env.sh to generate random values for both secrets below).
# Optional: set your own admin password (at least 12 characters), otherwise the server
# generates one on first start (docker compose exec labwarden cat /data/admin-password).
# LABWARDEN_ADMIN_PASSWORD=
# LABWARDEN_AUTH_DISABLED=true   # instead of a password: dashboard open to anyone who can reach it
# Bootstrap ingest token (>= 16 chars), also used by the testbed. docker-compose.yml
# refuses to start without it, because the testbed services in it need it.
# LABWARDEN_INGEST_TOKEN=
LABWARDEN_PORT=8080
# LABWARDEN_COOKIE_SECURE=true   # behind HTTPS
# LABWARDEN_TRUSTED_PROXIES=172.18.0.10   # the reverse proxy's own address, not a whole network
# LABWARDEN_EVENT_RETENTION=50000
# LABWARDEN_MAX_REPORT_MB=256
# LABWARDEN_DB_UPDATE_AT=03:00          # daily Grype DB check, then every stored SBOM is re-matched
# TZ=UTC                                # time zone for LABWARDEN_DB_UPDATE_AT
# LABWARDEN_SCAN_WORKERS=2              # grype processes at once (~115 MB each)
# LABWARDEN_QUEUE_MAX=1000              # SBOM uploads get 503 above this backlog
# Alerts about new findings (webhook URLs often embed a secret: keep them here only).
# LABWARDEN_NOTIFY_URL=https://ntfy.sh/your-topic
# LABWARDEN_NOTIFY_FORMAT=json          # json (Slack, Discord, Mattermost, Gotify, generic) | ntfy
# LABWARDEN_NOTIFY_MIN_SEVERITY=Critical
# LABWARDEN_NOTIFY_KEV=true             # also alert on known-exploited findings below that severity
# LABWARDEN_PUBLIC_URL=http://labwarden.lan:8080   # for links in alerts
