# Copy to .env (or run scripts/dev-env.sh to generate random values).
VULNX_ADMIN_PASSWORD=change-me
# Optional bootstrap ingest token (>= 16 chars), also used by the testbed.
VULNX_INGEST_TOKEN=
VULNX_PORT=8080
# VULNX_COOKIE_SECURE=true   # behind HTTPS
# VULNX_EVENT_RETENTION=50000
# VULNX_MAX_REPORT_MB=256
